<?xml version="1.0" encoding="utf-8"?>
<Project name="ZEIC_CORE">
    <Package name="Core">
        <Key ID="STR_ZEIC_core_GB_Confirm">
            <English>Garrison</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Description">
            <English>Places infantry of a faction on the positions inside buildings. Pick a faction (search and side narrow the list) and its subcategory, or a recently used pair. Radius 0 garrisons only the building under the module, otherwise the given share of the buildings within the radius.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Dynamic">
            <English>Dynamic simulation</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_DynamicTip">
            <English>Enables dynamic simulation for the units. Don't use it where the AI can easily be seen (outside, on roofs).</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Faction">
            <English>Faction</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_NoFaction">
            <English>Select a faction first.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Percent">
            <English>Occupied [%]</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_PercentTip">
            <English>Share of the buildings within the radius that get a garrison, picked at random.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Radius">
            <English>Radius [m]</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_RadiusTip">
            <English>0: only the building under the module. Otherwise a share of the buildings within this distance.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Recent">
            <English>Recently used</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_RecentTip">
            <English>Faction and subcategory pairs used in this game session. Picking one here replaces the faction below.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Search">
            <English>Search</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_SearchTip">
            <English>Part of the faction name or class, e.g. TKA</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Shortcut">
            <English>Shortcut: hold Alt while placing the module to garrison again with the last settings, without this dialog.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Side">
            <English>Side</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_SideAll">
            <English>All</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Subcategory">
            <English>Subcategory</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Title">
            <English>Garrison building</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Trigger">
            <English>Move AI trigger</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_TriggerTip">
            <English>Creates a trigger that lets the AI move once a player is near.</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_Units">
            <English>Units per building</English>
        </Key>
        <Key ID="STR_ZEIC_core_GB_UnitsTip">
            <English>Limited by the building's positions.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_AllowDamage">
            <English>Allow damage</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_AllowDamageTip">
            <English>The building can be destroyed. Its interior may be left floating.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Category">
            <English>Category</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Confirm">
            <English>Fill</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Description">
            <English>Furnishes buildings with props from a template of the chosen category. Radius 0 fills only the building under the module, otherwise every building within the radius, one after another. Simple objects are fastest; editable ones can be moved in Zeus, but many of them make Zeus slow.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Objects">
            <English>Objects</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ObjectsEditable">
            <English>Editable</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ObjectsEditableTip">
            <English>Can be moved and deleted in Zeus. Zeus gets slow with many of them.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ObjectsNormal">
            <English>Objects</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ObjectsNormalTip">
            <English>Normal objects, not added to Zeus.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ObjectsSimple">
            <English>Simple</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ObjectsSimpleTip">
            <English>Fastest. Can't be moved or deleted in Zeus.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Radius">
            <English>Radius [m]</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_RadiusTip">
            <English>0: only the building under the module. Otherwise all buildings within this distance.</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Shortcut">
            <English>Shortcuts, held while placing the module, skip this dialog. Alt: the last fill again%1 (each with the last radius and objects)</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_ShortcutCategory">
            <English>%1: %2</English>
        </Key>
        <Key ID="STR_ZEIC_core_IF_Title">
            <English>Interior fill</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_CategoryAll">
            <English>All</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_Confirm">
            <English>List</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_Description">
            <English>For template authors, VR only. Places every building class that has positions, with one arrow per template below it: one row per category, the colours are listed in chat. Use it to find buildings that need more templates.</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_Max">
            <English>Max templates</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_MaxTip">
            <English>Buildings with more templates than this in a listed category are left out. 0: only buildings without templates.</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_Positions">
            <English>Mark positions</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_PositionsTip">
            <English>Puts a green arrow on every building position.</English>
        </Key>
        <Key ID="STR_ZEIC_core_LB_Title">
            <English>List template buildings</English>
        </Key>
        <Key ID="STR_ZEIC_core_OF_Confirm">
            <English>Fill</English>
        </Key>
        <Key ID="STR_ZEIC_core_OF_Description">
            <English>Puts small props of the chosen type on a table, shelf, rack or similar object (the one under the module, or the nearest within 10 m). Tables also get something on the floor below them.</English>
        </Key>
        <Key ID="STR_ZEIC_core_OF_Percent">
            <English>Fill [%]</English>
        </Key>
        <Key ID="STR_ZEIC_core_OF_PercentTip">
            <English>Chance for each spot on the object to get a prop.</English>
        </Key>
        <Key ID="STR_ZEIC_core_OF_Shortcut">
            <English>Shortcut: hold Alt while placing the module to fill again with the last settings, without this dialog.</English>
        </Key>
